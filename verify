#!/usr/bin/env python3
"""一次性验收服务 verify。

执行内容：
  1. 代码测试：unittest 全套（LR(1) 解析、nullable/FIRST、闭包/goto、两类冲突）。
  2. 页面构建检查：静态页自洽性与可访问性关键要素。
  3. API/HTTP 冒烟：健康响应、复核页、无冲突文法、移进/归约冲突证据、归约/归约冲突证据。

目标地址：
  - 默认在本地临时端口启动应用进程并冒烟，结束后回收；
  - 通过 --base-url 或环境变量 BASE_URL 指定地址（Compose 中指向 web 服务）。

无论成功失败，执行完毕立即退出，并以退出码报告结果（0 通过 / 1 失败）。
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import threading
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)


def run_code_tests() -> bool:
    print("== 1/3 代码测试 + 2/3 页面构建检查 ==")
    proc = subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        cwd=ROOT,
        stderr=subprocess.STDOUT,
    )
    return proc.returncode == 0


def start_local_server():
    """在守护线程中启动临时端口服务，返回 (base_url, server)。"""
    from app.server import build_server

    server = build_server("127.0.0.1", 0)
    port = server.server_address[1]
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    # 等待端口就绪
    time.sleep(0.3)
    return f"http://127.0.0.1:{port}", server


def run_smoke(base_url: str) -> bool:
    print(f"\n== 3/3 API/HTTP 冒烟（{base_url}） ==")
    proc = subprocess.run(
        [sys.executable, os.path.join(ROOT, "scripts", "smoke_http.py"), base_url],
        cwd=ROOT,
    )
    return proc.returncode == 0


def main() -> int:
    parser = argparse.ArgumentParser(description="文法复核一次性验收")
    parser.add_argument(
        "--base-url",
        default=os.environ.get("BASE_URL"),
        help="冒烟目标地址；缺省时在本地临时端口自行启动服务",
    )
    args = parser.parse_args()

    started = args.base_url is None
    server = None
    if started:
        base_url, server = start_local_server()
    else:
        base_url = args.base_url.rstrip("/")

    try:
        tests_ok = run_code_tests()
        smoke_ok = run_smoke(base_url)
    finally:
        if server is not None:
            server.shutdown()
            server.server_close()

    print("\n===== 验收汇总 =====")
    print(f"  代码测试 / 页面构建：{'通过' if tests_ok else '失败'}")
    print(f"  API/HTTP 冒烟：     {'通过' if smoke_ok else '失败'}")
    if tests_ok and smoke_ok:
        print("结果：验收通过，退出码 0。")
        return 0
    print("结果：验收失败，退出码 1。")
    return 1


if __name__ == "__main__":
    sys.exit(main())
